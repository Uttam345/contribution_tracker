# GitHub username whose contributions are shown (public, inlined at build time).
# Defaults to the value in lib/constants.ts if unset.
NEXT_PUBLIC_GITHUB_USERNAME=hokagesama

# Public URL of the deployed site (used for sitemap / metadata).
# On Vercel this is picked up automatically; set it only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.dev

# Optional but strongly recommended: raises the GitHub search rate limit
# from 10 to 30 requests/minute. Use a fine-grained token with
# "Public repositories (read-only)" access and no other permissions.
GITHUB_TOKEN=
